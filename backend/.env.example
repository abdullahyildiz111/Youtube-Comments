# Required. Create a free key at https://aistudio.google.com/apikey
# Copy this file to backend/.env and put the real key there, not here.
GEMINI_API_KEY=your_gemini_api_key_here

# Optional overrides
GEMINI_MODEL=gemini-3.5-flash-lite
PORT=3000
RATE_LIMIT_PER_MINUTE=5

# Optional. If set, the extension must send Authorization: Bearer <token>
# EXTENSION_API_TOKEN=change-me
